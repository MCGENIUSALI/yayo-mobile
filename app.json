{
  "expo": {
    "name": "YA YO",
    "slug": "yayo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cd.yayo.marketplace"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "cd.yayo.marketplace"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0B",
          "image": "./assets/splash-logo.png",
          "imageWidth": 229,
          "resizeMode": "contain"
        }
      ],
      "expo-image",
      "expo-video",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "YA YO utilise tes photos pour ta photo de profil et les photos de tes produits.",
          "cameraPermission": "YA YO utilise l’appareil photo pour ta photo de profil et les photos de tes produits."
        }
      ]
    ],
    "scheme": "yayo",
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#0A0A0B"
  }
}
